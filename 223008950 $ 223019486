package one.secondwork;


// Step 1: Define the Loan class
public class loan1 {

    // Instance variables (fields)
    private double monthlyPayment;
    private int numOfYears;
    private double totalAmount;

    // Constructor to initialize all three variables
    public loan1(double totalAmount, int numOfYears, double monthlyPayment) {
        this.totalAmount = totalAmount;         // Use 'this' to refer to the instance variable
        this.numOfYears = numOfYears;           // Use 'this' to refer to the instance variable
        if (monthlyPayment > 0) {
            this.monthlyPayment = monthlyPayment; // If monthly payment is provided, store it.
        } else {
            calculateMonthlyPayment(); // Otherwise, calculate the monthly payment based on loan details.
        }
    }

    // Method to calculate the monthly payment if it was not provided
    public void calculateMonthlyPayment() {
        // Assume a fixed interest rate for simplicity (5% annual interest)
        double annualInterestRate = 0.05; 
        int totalMonths = numOfYears * 12;

        // Monthly interest rate (annual rate divided by 12 months)
        double monthlyInterestRate = annualInterestRate / 12;

        // Formula for monthly payment:
        // M = P * r * (1 + r)^n / ((1 + r)^n - 1)
        double compoundInterest = Math.pow(1 + monthlyInterestRate, totalMonths);
        this.monthlyPayment = totalAmount * monthlyInterestRate * compoundInterest / (compoundInterest - 1);
    }

    // Getter methods to access private variables
    public double getMonthlyPayment() {
        return monthlyPayment;
    }

    public int getNumOfYears() {
        return numOfYears;
    }

    public double getTotalAmount() {
        return totalAmount;
    }

    // Main method to test the Loan class
    public static void main(String[] args) {
        // Step 2: Create an object of Loan class with totalAmount, numOfYears, and monthlyPayment
        loan1 loan1 = new loan1(20000000, 5, 0);  
        
        // Step 3: Display the loan details
        System.out.println("Total Loan Amount: RF" + loan1.getTotalAmount());
        System.out.println("Loan Term: " + loan1.getNumOfYears() + " years");
        System.out.println("Monthly Payment: RF" + loan1.getMonthlyPayment());
    }
}

